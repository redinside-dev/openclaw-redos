# OpenClaw Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git!

# ==========================================
# TELEGRAM BOT TOKENS
# ==========================================
TELEGRAM_BOT_TOKEN_DEFAULT=YOUR_DEFAULT_BOT_TOKEN_HERE
TELEGRAM_BOT_TOKEN_ALLROUNDER=YOUR_ALLROUNDER_BOT_TOKEN_HERE
TELEGRAM_BOT_TOKEN_ENG=YOUR_ENG_BOT_TOKEN_HERE
TELEGRAM_BOT_TOKEN_RESEARCH=YOUR_RESEARCH_BOT_TOKEN_HERE
TELEGRAM_BOT_TOKEN_FINANCE=YOUR_FINANCE_BOT_TOKEN_HERE
TELEGRAM_BOT_TOKEN_OPS=YOUR_OPS_BOT_TOKEN_HERE
TELEGRAM_BOT_TOKEN_INFOSEC=YOUR_INFOSEC_BOT_TOKEN_HERE

# ==========================================
# THIRD-PARTY API KEYS
# ==========================================
ZAI_API_KEY=YOUR_ZAI_API_KEY_HERE
PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY_HERE
GITHUB_PAT=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN_HERE

# ==========================================
# MCP / CONTEXT7
# ==========================================
CONTEXT7_API_KEY=YOUR_CONTEXT7_API_KEY_HERE

# ==========================================
# MISSION CONTROL DASHBOARD AUTH
# ==========================================
DASHBOARD_USER=red
DASHBOARD_PASS=YOUR_DASHBOARD_PASSWORD_HERE

# ==========================================
# GATEWAY CONFIGURATION
# ==========================================
GATEWAY_AUTH_TOKEN=YOUR_GATEWAY_AUTH_TOKEN_HERE
GATEWAY_PORT=19000

# ==========================================
# OLLAMA CONFIGURATION
# ==========================================
OLLAMA_HOST=http://localhost:11434

# ==========================================
# BUDGET LIMITS
# ==========================================
DAILY_BUDGET=5
HOURLY_BUDGET=1

# ==========================================
# DEVELOPER SETTINGS
# ==========================================
NODE_ENV=development
LOG_LEVEL=info
