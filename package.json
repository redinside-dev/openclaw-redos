    "upgrade:cli": "bash upgrade.sh cli",
    "upgrade:all": "bash upgrade.sh all"
  },
  "keywords": [
    "ai",
    "agents",
    "cost-optimization",
    "kanban",
    "autonomous-learning",
    "ceo-agents"
  ],
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "node-telegram-bot-api": "^0.67.0",
    "ws": "^8.16.0"
  }
