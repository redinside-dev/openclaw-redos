  "howToSwitch": {
    "_instructions": "To change a model for any agent:",
    "steps": [
      "1. Edit /Users/redinside/.openclaw/openclaw.json → agents.list[] → find agent by id → update model.primary and model.fallbacks",
      "2. Run: openclaw doctor  (validates the config)",
      "3. Restart gateway: launchctl unload ~/Library/LaunchAgents/ai.openclaw.gateway.plist && sleep 1 && launchctl load ~/Library/LaunchAgents/ai.openclaw.gateway.plist",
      "4. Update agentModelMap above to keep this registry in sync"
    ],
    "example": "To switch ENG from gpt-oss:20b to llama3.1:8b: set primary to 'ollama/llama3.1:8b' in openclaw.json"
  },

