{"$schema": "http://json-schema.org/draft-07/schema#", "title": "Enhanced Tools Schema", "description": "JSON schemas for enhanced tools validation", "tool_schemas": {"enhanced_web_fetch": {"type": "object", "properties": {"urls": {"type": "array", "items": {"type": "string", "format": "uri"}, "minItems": 1, "maxItems": 10, "description": "URLs to fetch content from"}, "taskNameActive": {"type": "string", "minLength": 2, "maxLength": 50, "description": "Task name while running"}, "taskNameComplete": {"type": "string", "minLength": 2, "maxLength": 50, "description": "Task name when complete"}, "extract_metadata": {"type": "boolean", "default": true, "description": "Extract title, author, date"}, "clean_content": {"type": "boolean", "default": true, "description": "Remove HTML/markdown formatting"}, "timeout": {"type": "integer", "minimum": 5, "maximum": 120, "default": 30, "description": "Request timeout in seconds"}, "explanation": {"type": "string", "minLength": 10, "description": "Why this tool is being used"}, "expected": {"type": "string", "minLength": 10, "description": "What success looks like"}, "risk": {"type": "string", "enum": ["low", "medium", "high"], "default": "medium"}, "taskNameActive": {"type": "string", "minLength": 2, "maxLength": 50, "description": "Task name while running"}, "taskNameComplete": {"type": "string", "minLength": 2, "maxLength": 50, "description": "Task name when complete"}}, "required": ["urls", "explanation", "expected", "taskNameActive", "taskNameComplete"], "additionalProperties": false}, "enhanced_repo_search": {"type": "object", "properties": {"pattern": {"type": "string", "minLength": 1, "description": "Regex pattern to search for"}, "path": {"type": "string", "description": "Directory to search within (optional)"}, "globPattern": {"type": "string", "description": "Glob pattern for file filtering (optional)"}, "max_results": {"type": "integer", "minimum": 1, "maximum": 500, "default": 200, "description": "Maximum results to return"}, "context_lines": {"type": "integer", "minimum": 0, "maximum": 10, "default": 2, "description": "Lines of context around matches"}, "case_sensitive": {"type": "boolean", "default": false, "description": "Case sensitive matching"}, "explanation": {"type": "string", "minLength": 10, "description": "Why this tool is being used"}, "expected": {"type": "string", "minLength": 10, "description": "What success looks like"}, "risk": {"type": "string", "enum": ["low", "medium", "high"], "default": "low"}, "taskNameActive": {"type": "string", "minLength": 2, "maxLength": 50, "description": "Task name while running"}, "taskNameComplete": {"type": "string", "minLength": 2, "maxLength": 50, "description": "Task name when complete"}}, "required": ["pattern", "explanation", "expected", "taskNameActive", "taskNameComplete"], "additionalProperties": false}}, "response_contract": {"type": "object", "properties": {"answer": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 10, "description": "Search results and findings"}, "evidence": {"type": "array", "items": {"type": "string"}, "description": "Files searched and matches found"}, "action": {"type": "array", "items": {"type": "string"}, "description": "Next steps based on results"}, "risks": {"type": "array", "items": {"type": "string"}, "description": "Search limitations and considerations"}}, "required": ["answer", "evidence", "action"], "additionalProperties": false}}
