[
  { "tier": 0, "tool": "read",         "agent": "*" },
  { "tier": 0, "tool": "search",       "agent": "*" },
  { "tier": 0, "tool": "sessions_list","agent": "*" },
  { "tier": 0, "tool": "web_search",   "agent": "research" },

  { "tier": 1, "tool": "write",        "agent": "*", "pattern": "workspace/" },
  { "tier": 1, "tool": "message",      "agent": "*" },
  { "tier": 1, "tool": "sessions_send","agent": "*" },

  { "tier": 2, "tool": "exec", "agent": "eng", "pattern": "npm (test|run (test|lint|build|typecheck|check))" },
  { "tier": 2, "tool": "exec", "agent": "eng", "pattern": "pytest( .*)?" },
  { "tier": 2, "tool": "exec", "agent": "eng", "pattern": "git (add|commit|diff|log|status|show)" },
  { "tier": 2, "tool": "exec", "agent": "eng", "pattern": "node (--version|--help)" },
  { "tier": 2, "tool": "exec", "agent": "eng", "pattern": "tsc --noEmit" },
  { "tier": 2, "tool": "exec", "agent": "eng", "pattern": "eslint" },
  { "tier": 2, "tool": "exec", "agent": "eng", "pattern": "python3? -m (pytest|mypy|flake8)" },

  { "tier": 2, "tool": "exec", "agent": "ops", "pattern": "launchctl (stop|start) ai\\.openclaw\\." },
  { "tier": 2, "tool": "exec", "agent": "ops", "pattern": "launchctl (stop|start) homebrew\\.mxcl\\.ollama" },
  { "tier": 2, "tool": "exec", "agent": "ops", "pattern": "openclaw (status|gateway probe|logs|doctor)" },
  { "tier": 2, "tool": "exec", "agent": "ops", "pattern": "curl -s --max-time \\d+ http://localhost:\\d+/health" },
  { "tier": 2, "tool": "exec", "agent": "ops", "pattern": "bash ~/.openclaw/workspace/scripts/(hourly-snapshot|system-pulse|ollama-health|disk-watchdog)\\.sh" },
  { "tier": 2, "tool": "exec", "agent": "ops", "pattern": "bash ~/.openclaw/scripts/redos-restart\\.sh" },
  { "tier": 2, "tool": "exec", "agent": "ops", "pattern": "git (log|status|diff|show)" },
  { "tier": 2, "tool": "exec", "agent": "ops", "pattern": "tail -[fn]" },

  { "tier": 3, "tool": "exec", "agent": "ops", "pattern": "launchctl (stop|start) (?!ai\\.openclaw|homebrew\\.mxcl\\.ollama)" },
  { "tier": 3, "tool": "exec", "agent": "ops", "pattern": "crontab" },
  { "tier": 3, "tool": "exec", "agent": "*",   "pattern": "npm install" },
  { "tier": 3, "tool": "exec", "agent": "*",   "pattern": "pip install" },
  { "tier": 3, "tool": "exec", "agent": "eng", "pattern": "git push(?! (origin )?main)(?! --force)" },

  { "tier": 4, "tool": "exec", "agent": "eng", "pattern": "git push (origin )?main" },
  { "tier": 4, "tool": "exec", "agent": "*",   "pattern": "npm publish" },
  { "tier": 4, "tool": "exec", "agent": "*",   "pattern": "brew install" },

  { "tier": 5, "tool": "exec", "agent": "*",   "pattern": "rm -rf" },
  { "tier": 5, "tool": "exec", "agent": "*",   "pattern": "sudo" },
  { "tier": 5, "tool": "exec", "agent": "*",   "pattern": "git push --force" },
  { "tier": 5, "tool": "exec", "agent": "*",   "pattern": "mkfs" },
  { "tier": 5, "tool": "exec", "agent": "*",   "pattern": "DROP TABLE" },

  { "tier": 2, "tool": "exec", "agent": "eng", "pattern": ".*" },
  { "tier": 3, "tool": "exec", "agent": "ops", "pattern": ".*" },
  { "tier": 2, "tool": "*",    "agent": "*" }
]
