{"$schema": "http://json-schema.org/draft-07/schema#", "title": "Competitive Intelligence Schema", "description": "JSON schemas for competitive intelligence validation", "tool_schemas": {"competitive_analysis": {"type": "object", "properties": {"repository": {"type": "string", "format": "uri", "description": "GitHub repository URL"}, "focus_areas": {"type": "array", "items": {"type": "string", "enum": ["tool_governance", "prompt_engineering", "ux_patterns", "security", "performance"]}, "description": "Areas to focus analysis on"}, "implementation_timeline": {"type": "string", "enum": ["quick_wins", "medium_term", "long_term"], "default": "quick_wins", "description": "Implementation timeline preference"}, "explanation": {"type": "string", "minLength": 10, "description": "Why this analysis is needed"}, "expected": {"type": "string", "minLength": 10, "description": "What success looks like"}, "risk": {"type": "string", "enum": ["low", "medium", "high"], "default": "low"}, "taskNameActive": {"type": "string", "minLength": 2, "maxLength": 50, "description": "Task name while running"}, "taskNameComplete": {"type": "string", "minLength": 2, "maxLength": 50, "description": "Task name when complete"}}, "required": ["repository", "explanation", "expected", "taskNameActive", "taskNameComplete"], "additionalProperties": false}}, "response_contract": {"type": "object", "properties": {"answer": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 10, "description": "Key findings and recommendations"}, "evidence": {"type": "array", "items": {"type": "string"}, "description": "Sources analyzed and patterns identified"}, "action": {"type": "array", "items": {"type": "string"}, "description": "Implementation steps and priorities"}, "risks": {"type": "array", "items": {"type": "string"}, "description": "Implementation risks and considerations"}}, "required": ["answer", "evidence", "action"], "additionalProperties": false}}
