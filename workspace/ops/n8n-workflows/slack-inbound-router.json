      "id": "webhook-trigger",
      "name": "Slack Events Webhook",
      "webhookId": "20761b31-7666-4a06-862e-3d75ec19a050",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\n// Handle Slack URL verification challenge\nif (body.type === 'url_verification') {\n  return [{ json: { challenge: body.challenge, _isChallenge: true, _skip: false } }];\n}\n\n// Extract event data\nconst event = body.event || {};\nconst text = event.text || '';\nconst channel = event.channel || '';\nconst user = event.user || '';\nconst bot_id = event.bot_id;\n\n// Mark bot messages to skip\nif (bot_id) {\n  return [{ json: { _skip: true, _isChallenge: false, agentId: 'main', message: '', channel, user } }];\n}\n\n// Route to agent based on keywords\nlet agentId = 'main';\nconst textLower = text.toLowerCase();\nif (textLower.includes('code') || textLower.includes('bug') || textLower.includes('deploy') || textLower.includes('pr')) agentId = 'eng';\nelse if (textLower.includes('security') || textLower.includes('vuln') || textLower.includes('breach')) agentId = 'infosec';\nelse if (textLower.includes('cost') || textLower.includes('budget') || textLower.includes('spend') || textLower.includes('portfolio')) agentId = 'finance';\nelse if (textLower.includes('research') || textLower.includes('market') || textLower.includes('analysis')) agentId = 'research';\nelse if (textLower.includes('ticket') || textLower.includes('ops') || textLower.includes('status')) agentId = 'ops';\n\nconst message = `SLACK MESSAGE from ${user} in ${channel}:\\n${text}\\n\\nRespond appropriately.`;\nreturn [{ json: { agentId, message, channel, user, _skip: false, _isChallenge: false } }];"
      },
      "id": "route-message",
      "name": "Route Slack Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "conditions": [
            {
              "id": "challenge-check",
              "leftValue": "={{ $json._isChallenge }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "is-challenge",
      "name": "Is Challenge?",
