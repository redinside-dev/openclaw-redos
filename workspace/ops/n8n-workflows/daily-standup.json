      "parameters": {
        "jsCode": "// Build standup kickoff messages for each agent\nconst agents = [\n  { id: 'main', delay: 0 },\n  { id: 'eng', delay: 2000 },\n  { id: 'research', delay: 4000 },\n  { id: 'finance', delay: 6000 },\n  { id: 'ops', delay: 8000 },\n  { id: 'infosec', delay: 10000 }\n];\n\nconst date = new Date().toLocaleDateString('en-CA');\nconst messages = agents.map(a => ({\n  agentId: a.id,\n  message: `MORNING STANDUP ${date}: Write your status to workspace/ops/agent-status/${a.id}.json with fields: sprintGoal, workingOn, completedYesterday, ETA, blockers. Keep it brief \u2014 OPS will compile at 8:15am.`,\n  delay: a.delay\n}));\n\nreturn messages.map(m => ({ json: m }));"
      },
