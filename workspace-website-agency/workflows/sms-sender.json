{
  "name": "SMS Sender",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sms-sender",
        "responseMode": "onReceived"
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "sms-sender"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, sid: 'SM' & $now.toUnix(), phone: $json.body.phone } }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [500, 300]
    }
  ],
  "connections": {
    "Webhook": {"main": [[{"node": "Respond", "type": "main", "index": 0}]]}
  }
}
