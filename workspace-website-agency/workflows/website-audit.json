{
  "name": "Website Audit",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "website-audit",
        "responseMode": "onReceived"
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "website-audit"
    },
    {
      "parameters": {
        "url": "={{ $json.body.url }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "fetch",
      "name": "Fetch Website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { grade: 'D', scores: { speed: 2, mobile: 1, seo: 1, design: 2, content: 2 }, issues: ['Slow load', 'No mobile', 'No SEO'], url: $json.body.url } }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [750, 300]
    }
  ],
  "connections": {
    "Webhook": {"main": [[{"node": "Fetch Website", "type": "main", "index": 0}]]},
    "Fetch Website": {"main": [[{"node": "Respond", "type": "main", "index": 0}]]}
  }
}
