{
  "name": "Voice Call Schedule",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "voice-call-schedule",
        "responseMode": "onReceived"
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "voice-call-schedule"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, callId: 'call-' & $now.toUnix(), phone: $json.body.phone, scheduledFor: $json.body.scheduleAt } }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [500, 300]
    }
  ],
  "connections": {
    "Webhook": {"main": [[{"node": "Respond", "type": "main", "index": 0}]]}
  }
}
