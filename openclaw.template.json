{
  "version": "3.5.0",
  "name": "OpenClaw Enhanced",
  "description": "Multi-agent AI orchestration system with HATAKE intelligence",

  "gateway": {
    "enabled": true,
    "port": 19000,
    "host": "localhost",
    "authToken": "USE_ENVIRONMENT_VARIABLE_GATEWAY_AUTH_TOKEN",
    "corsEnabled": true,
    "rateLimiting": {
      "enabled": false,
      "maxRequests": 100,
      "windowMs": 60000
    }
  },

  "ollama": {
    "enabled": true,
    "baseUrl": "http://localhost:11434",
    "models": {
      "default": "llama3.1:8b",
      "code": "qwen2.5-coder:7b",
      "fast": "llama3.1:8b"
    }
  },

  "agents": [
    {
      "id": "main",
      "name": "RED (Default Agent)",
      "description": "Default assistant for general queries",
      "personality": "professional, helpful, efficient",
      "telegram": {
        "enabled": true,
        "botToken": "USE_ENVIRONMENT_VARIABLE_TELEGRAM_BOT_TOKEN_DEFAULT",
        "botUsername": "your_bot_username"
      },
      "model": {
        "provider": "ollama",
        "model": "llama3.1:8b"
      }
    },
    {
      "id": "allrounder",
      "name": "Zen (All-rounder)",
      "description": "Balanced agent for diverse tasks",
      "personality": "versatile, thoughtful, balanced",
      "telegram": {
        "enabled": true,
        "botToken": "USE_ENVIRONMENT_VARIABLE_TELEGRAM_BOT_TOKEN_ALLROUNDER",
        "botUsername": "your_allrounder_bot"
      },
      "model": {
        "provider": "ollama",
        "model": "llama3.1:8b"
      }
    },
    {
      "id": "eng",
      "name": "ENG (Engineering)",
      "description": "Code generation and development expert",
      "personality": "technical, precise, best-practices focused",
      "telegram": {
        "enabled": true,
        "botToken": "USE_ENVIRONMENT_VARIABLE_TELEGRAM_BOT_TOKEN_ENG",
        "botUsername": "your_eng_bot"
      },
      "model": {
        "provider": "ollama",
        "model": "qwen2.5-coder:7b"
      }
    },
    {
      "id": "research",
      "name": "RESEARCH (Information)",
      "description": "Research and information gathering specialist",
      "personality": "thorough, analytical, source-driven",
      "telegram": {
        "enabled": true,
        "botToken": "USE_ENVIRONMENT_VARIABLE_TELEGRAM_BOT_TOKEN_RESEARCH",
        "botUsername": "your_research_bot"
      },
      "model": {
        "provider": "ollama",
        "model": "llama3.1:8b"
      }
    },
    {
      "id": "finance",
      "name": "FINANCE (Financial)",
      "description": "Financial analysis and cost tracking",
      "personality": "precise, data-driven, cost-conscious",
      "telegram": {
        "enabled": true,
        "botToken": "USE_ENVIRONMENT_VARIABLE_TELEGRAM_BOT_TOKEN_FINANCE",
        "botUsername": "your_finance_bot"
      },
      "model": {
        "provider": "ollama",
        "model": "llama3.1:8b"
      }
    },
    {
      "id": "ops",
      "name": "OPS (Operations)",
      "description": "Code validation and quality assurance",
      "personality": "meticulous, quality-focused, systematic",
      "telegram": {
        "enabled": true,
        "botToken": "USE_ENVIRONMENT_VARIABLE_TELEGRAM_BOT_TOKEN_OPS",
        "botUsername": "your_ops_bot"
      },
      "model": {
        "provider": "ollama",
        "model": "llama3.1:8b"
      }
    },
    {
      "id": "infosec",
      "name": "INFOSEC (Security)",
      "description": "Security and compliance specialist",
      "personality": "security-conscious, thorough, proactive",
      "telegram": {
        "enabled": true,
        "botToken": "USE_ENVIRONMENT_VARIABLE_TELEGRAM_BOT_TOKEN_INFOSEC",
        "botUsername": "your_infosec_bot"
      },
      "model": {
        "provider": "ollama",
        "model": "llama3.1:8b"
      }
    }
  ],

  "thirdParty": {
    "zai": {
      "enabled": false,
      "apiKey": "USE_ENVIRONMENT_VARIABLE_ZAI_API_KEY"
    },
    "perplexity": {
      "enabled": false,
      "apiKey": "USE_ENVIRONMENT_VARIABLE_PERPLEXITY_API_KEY",
      "model": "llama-3.1-sonar-small-128k-online"
    }
  },

  "budget": {
    "daily": 5,
    "hourly": 1,
    "alertThreshold": 0.8
  },

  "features": {
    "hatake": {
      "enabled": true,
      "promptEngineering": true,
      "modelSelection": true
    },
    "edRed": {
      "enabled": true,
      "orchestration": true
    },
    "missionControl": {
      "enabled": true,
      "webSocket": true,
      "port": 19000
    },
    "resilience": {
      "errorHandler": true,
      "devOpsAgent": true,
      "taskScheduler": true,
      "ticketSystem": true
    }
  },

  "logging": {
    "level": "info",
    "errors": "logs/errors.jsonl",
    "health": "logs/health.jsonl",
    "performance": "logs/performance.jsonl",
    "tickets": "logs/tickets.jsonl"
  }
}
